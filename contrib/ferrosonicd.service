[Unit]
Description=Ferrosonic music daemon
Documentation=https://github.com/jaidaken/ferrosonic
After=graphical-session.target pipewire.service

[Service]
Type=simple
# Matches install.sh's INSTALL_DIR (/usr/local/bin). Adjust to
# %h/.local/bin/ferrosonic for a user-local install.
ExecStart=/usr/local/bin/ferrosonic --daemon
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=default.target
